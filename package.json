{
  "name": "zofhub",
  "version": "2.0.0",
  "description": "ZoFHub — modern arcade-style portal: embedded HTML5 games, free AI, smart proxy browser.",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node --use-system-ca server.js",
    "dev": "node --use-system-ca --watch server.js",
    "restart": "node tools/kill-port.mjs 8080 && node --use-system-ca server.js",
    "kill-port": "node tools/kill-port.mjs 8080",
    "proxies": "node tools/proxies.mjs",
    "dev:all": "node tools/dev-all.mjs",
    "build-mvp": "node --use-system-ca tools/build-mvp.mjs",
    "check": "node tools/check-js.mjs",
    "verify-thumbs": "node tools/verify-thumbnails.mjs",
    "migrate": "node --use-system-ca tools/migrate-to-supabase.mjs",
    "migrate:dry": "node --use-system-ca tools/migrate-to-supabase.mjs --dry-run",
    "migrate:curated": "node --use-system-ca tools/migrate-to-supabase.mjs --curated",
    "migrate:curated:dry": "node --use-system-ca tools/migrate-to-supabase.mjs --curated --dry-run",
    "migrate:all": "node --use-system-ca tools/migrate-to-supabase.mjs",
    "grow": "node --use-system-ca tools/grow-catalog.mjs",
    "clean-fakes": "node tools/clean-fake-gd-hashes.mjs",
    "link-check": "node --use-system-ca tools/link-checker.mjs",
    "link-check:full": "node --use-system-ca tools/linkcheck-full.mjs",
    "export-games": "node --use-system-ca tools/export-games.mjs",
    "restore-games": "node --use-system-ca tools/restore-games.mjs",
    "fix-thumbnails": "node --use-system-ca tools/fetch-y8-thumbs.mjs",
    "audit": "node --use-system-ca tools/audit-catalog.mjs",
    "add-slope": "node --use-system-ca tools/add-slope.mjs",
    "add-game": "node --use-system-ca tools/add-game.mjs",
    "mood-index": "node tools/run-python.mjs tools/build-mood-index.py",
    "fix-missing-thumbs": "node tools/run-python.mjs tools/fetch_thumbnails.py",
    "scrape-thumbs": "node tools/run-python.mjs tools/scrape_thumbnails.py",
    "normalize-thumbs": "node tools/run-python.mjs tools/normalize_thumbnails.py",
    "purge-eduame": "node --use-system-ca tools/purge-eduame.mjs",
    "y8-scrape": "node --use-system-ca scrape-y8.js",
    "y8-harvest": "node --use-system-ca y8-harvest.js",
    "y8-sync": "node --use-system-ca lib/y8-ingest.mjs",
    "audit-thumbnails": "node --use-system-ca tools/audit-thumbnails.mjs",
    "audit-licensing": "node --use-system-ca tools/audit-licensing.mjs",
    "build-merged": "node --use-system-ca tools/build-merged.mjs",
    "cleanup-ip": "node --use-system-ca tools/cleanup-ip.mjs",
    "build-curated": "node --use-system-ca tools/build-curated.mjs",
    "upgrade-y8-thumbs": "node tools/run-python.mjs tools/upgrade_y8_thumbs.py",
    "sync-migrations": "node tools/sync-supabase-migrations.mjs",
    "check-ads": "node tools/check-ads.mjs",
    "gamezop": "node --use-system-ca tools/set-gamezop-partner.mjs",
    "rec-index": "node tools/run-python.mjs tools/build-recommendations.py",
    "feed-rank": "node tools/run-python.mjs tools/analyze-catalog.py",
    "db:verify": "node tools/run-python.mjs tools/audit.py live",
    "db:verify:strict": "node tools/run-python.mjs tools/audit.py live --fail-on warn",
    "audit:repo": "node tools/run-python.mjs tools/audit.py",
    "audit:repo:json": "node tools/run-python.mjs tools/audit.py --json",
    "audit:sql": "node tools/run-python.mjs tools/audit.py sql",
    "audit:ci": "node tools/run-python.mjs tools/audit.py sql json env api deps assets perf --min-severity warn --fail-on warn",
    "build-all-in-one": "node tools/build-all-in-one.mjs",
    "build-schema-only": "node tools/build-all-in-one.mjs --schema-only",
    "check-schema-only": "node tools/build-all-in-one.mjs --schema-only --check",
    "check-all-in-one": "node tools/build-all-in-one.mjs --check",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "admin-hash": "node tools/hash-admin-password.mjs",
    "quality": "node tools/catalog-quality.mjs",
    "css-tokens": "node tools/css-tokens.mjs",
    "og-sync": "node tools/sync-onlinegames.mjs",
    "game-attributes": "node tools/run-python.mjs tools/build-game-attributes.py",
    "eval-rec": "node tools/run-python.mjs tools/eval-recommendations.py",
    "verify-catalog": "node --use-system-ca tools/verify-catalog.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mercuryworkshop/bare-mux": "^2.1.7",
    "@mercuryworkshop/epoxy-transport": "^2.1.20",
    "@mercuryworkshop/libcurl-transport": "^2.0.5",
    "@mercuryworkshop/scramjet": "^1.1.0",
    "@mercuryworkshop/wisp-js": "^0.4.1",
    "@supabase/supabase-js": "^2.108.1",
    "@titaniumnetwork-dev/ultraviolet": "^3.2.10",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "libcurl.js": "0.7.4",
    "node-cron": "^4.2.1",
    "stream-chain": "^4.2.5",
    "stream-json": "^1.9.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "author": "ZSM1010",
  "homepage": "https://github.com/ZSM1010/ZoFHub-Gaming-AI-Browser-Hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZSM1010/ZoFHub-Gaming-AI-Browser-Hub.git"
  },
  "bugs": {
    "url": "https://github.com/ZSM1010/ZoFHub-Gaming-AI-Browser-Hub/issues"
  }
}
