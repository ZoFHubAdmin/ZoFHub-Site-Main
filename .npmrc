# Always install/audit over HTTPS (TLS) — never plaintext HTTP. Protects the
# dependency supply chain from tampering on the wire and lets `npm audit` run.
registry=https://registry.npmjs.org/
# Fail CI-style installs if a HIGH/critical advisory appears.
audit-level=high

# No dependency executes code during install. No package in the tree declares an install
# script today; this line keeps it that way. (It was added when @mercuryworkshop/scramjet's
# "preinstall": "npx only-allow pnpm" — a package-manager guard that exits 1 under npm — would
# have aborted the deploy build on npm 10, which has no install-script gate. That package, and
# the bufferutil accelerator that came with the Wisp tunnel, are gone with the proxy browser;
# test/supply-chain.test.mjs still scans node_modules and fails on any new install script
# until it has been read and added to its reviewed list.)
#
# Set here rather than via `npm approve-scripts` because that writes a
# machine-local approval; this file is committed, so local, CI, Render and
# Docker all install identically. Explicit `npm run <script>` is unaffected.
ignore-scripts=true
