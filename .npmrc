# Always install/audit over HTTPS (TLS) — never plaintext HTTP. Protects the
# dependency supply chain from tampering on the wire and lets `npm audit` run.
registry=https://registry.npmjs.org/
# Fail CI-style installs if a HIGH/critical advisory appears.
audit-level=high

# No dependency executes code during install. Two packages in this tree declare
# install scripts and BOTH must stay blocked:
#
#   @mercuryworkshop/scramjet  "preinstall": "npx only-allow pnpm"
#       A package-manager guard that exits 1 under npm — it does not build
#       anything, it ABORTS the install. Verified: running that exact command
#       with an npm user agent exits 1. npm 11.6+ happens to gate install
#       scripts behind `npm approve-scripts`, which is the only reason installs
#       succeed on a current npm. render.yaml pins NODE_VERSION=22, which ships
#       npm 10 — no gate — so without this line the deploy build dies at
#       preinstall. Scramjet ships `files: [dist, lib]`; the script is metadata
#       for its own contributors and blocking it removes nothing at runtime.
#
#   bufferutil                 "install": "node-gyp-build"
#       An optional native accelerator for `ws` (used by the Wisp tunnel). It
#       ships prebuilt binaries for linux-x64, win32-x64 and darwin-*, and
#       node-gyp-build resolves those at REQUIRE time, not install time — so the
#       addon loads with the script blocked and no node_modules/bufferutil/build
#       directory is ever produced. Verified by loading it. This is also why the
#       deploy needs no Python or C++ toolchain.
#
# Set here rather than via `npm approve-scripts` because that writes a
# machine-local approval; this file is committed, so local, CI, Render and
# Docker all install identically. Explicit `npm run <script>` is unaffected.
ignore-scripts=true
