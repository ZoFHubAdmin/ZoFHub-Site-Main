# =====================================================================
# ZoFHub · environment variables
# =====================================================================
# Copy this file to `.env` and fill in real values.
#   PowerShell:  Copy-Item .env.example .env
#
# Read on startup by your host (Render / Railway / Fly / etc.)
# Locally:  node --env-file=.env server.js   (Node 20+)
# =====================================================================


# ---------------- Server ----------------
PORT=8080
HOST=0.0.0.0
# NODE_ENV=production
# NO_OPEN=1                      # don't auto-open the browser on boot


# ---------------- Supabase (free tier) ----------------
# Find these in:  Supabase Dashboard → Project Settings → API
#
# The code accepts EITHER naming style — pick whichever matches what your
# host gave you.  Both are read at boot; the bare name wins if both exist.
#
#   Style A (bare):              SUPABASE_URL              + SUPABASE_*_KEY
#   Style B (Next.js convention):NEXT_PUBLIC_SUPABASE_URL  + NEXT_PUBLIC_SUPABASE_*_KEY
#
# IMPORTANT — key roles:
#   - SERVICE_ROLE key: bypasses Row-Level Security.  REQUIRED on the
#     server for the cron link-checker (UPDATE is_working=false) and the
#     migration script (INSERT new rows).  Treat it like a database password
#     — never ship it to the browser, never commit it.
#   - PUBLISHABLE / ANON key: subject to RLS.  Read-only as long as your
#     RLS policy only allows SELECT.  Safe to expose in browser bundles.
#
# All three are filled in. SERVICE_ROLE bypasses RLS - server-side only,
# never shipped to the browser.
SUPABASE_URL=https://jfflnuvqjlrcuqzyglnn.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_HEYOSWUQk2FYEzRaikQh5w_ZY1jW8WT
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpmZmxudXZxamxyY3VxenlnbG5uIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4Mjg0NzkxOCwiZXhwIjoyMDk4NDIzOTE4fQ.heRU4_Pf4Au9s71p5hdwvP5N10fjO0pHv1vOQ-ribts


# Alternative names (Next.js-style) — the code reads these too if set.
# Don't set BOTH styles, that's just noise; pick one.
# NEXT_PUBLIC_SUPABASE_URL=https://qemiyzaimvjrjmgdfsks.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_6Aud5-iascbVzAIkiCE-LQ_LcJSy0fI


# ---------------- Leaderboard anti-cheat ----------------
# REQUIRED for the leaderboard to stay trustworthy across restarts.
# server.js falls back to randomBytes(32) when this is unset, so every restart
# invalidates every proof-of-play token already issued to a player: a genuine
# score submitted across a redeploy gets rejected, and the anti-cheat silently
# resets itself. Set once, keep stable, do not rotate casually.
SCORE_SECRET=5d07fcc8280af9f643e6ab805ad8a5fb98a23f0de48626d1cb30635064eb13c4
# Optional: trim each game's leaderboard to its top N (default 200).
# SCORES_KEEP_PER_GAME=200


# ---------------- Admin review console ----------------
# Unlocks /admin and /api/admin/scores/* so quarantined ("flagged") scores can
# be approved or rejected. Auth FAILS CLOSED - without this the routes return
# 503 and flagged scores sit unreviewable forever. Send as
# "Authorization: Bearer <secret>", or paste into the /admin login box.
ADMIN_SECRET=5212182f74ac4165dce6ab0b5b4e4321beecac1c9a18036bf89ac7be82285f10


# ---------------- Keep-alive / uptime ----------------
# Protects GET /healthz and /ping. While unset that endpoint is PUBLIC.
# Point an external monitor (e.g. cron-job.org) at /healthz every ~10 min so a
# free tier never sleeps; it also pokes Supabase so the free DB never pauses.
# The monitor must send one of:
#   Authorization: Bearer <secret> | x-cron-secret: <secret> | ?key=<secret>
CRON_SECRET=db5076898af5072fcda9dde6d2a876a1071bfd7973c0242efbccd91d22d52507


# ---------------- Legal pages ----------------
# Shown on Privacy / Terms / DMCA / Cookies.
# LEFT BLANK DELIBERATELY - filling in an invented address would publish a
# contact that does not exist. While blank the legal pages link to the repo
# Issues page instead. A real inbox is strongly recommended before applying to
# any ad network or receiving DMCA notices.
CONTACT_EMAIL=zofhubadmin@proton.me
# Public site URL once deployed, e.g. https://zofhub.onrender.com
# Blank => the policies just say "this website".
SITE_URL=


# ---------------- AI (Pollinations) ----------------
# Bare hostname (no scheme) sent as the attribution referrer. Set to your real
# domain after deploying; until then requests use the built-in default.
# POLLINATIONS_REFERRER=your-domain.example

# ---------------- Redis cache ----------------
# OPTIONAL. When REDIS_URL is unset the app uses a bounded in-process
# LRU (works fine for one node; cache resets on restart).
#
# Set REDIS_URL to enable distributed caching that survives restarts and
# multi-instance horizontal scaling.  Free options:
#   - Upstash Redis Free   : rediss://default:<pwd>@<host>.upstash.io:6379
#   - Redis Cloud Free     : redis://default:<pwd>@<host>:<port>
#   - Render Redis Free    : redis://red-xxx:6379
#
# Free tiers typically allow ~10K commands/day or ~30 MB storage —
# enough for the games-paginated cache on a small/medium site.
# REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379


# ---------------- Cron ----------------
# Set to 1 to disable the in-process cron jobs (link-check + promote).
# Useful for tests, or when running on Render Free where the dyno sleeps
# (in which case use Render's separate Cron Job service instead).
# CRON_DISABLED=1
POLLINATIONS_PUBLIC_KEY=pk_a5JXyD8GE9zcRKhU


# ==============================================================================
# ADS — proxy-friendly ad-network stack   (fill in after your dad signs up)
# ==============================================================================
# ZoFHub runs the proxy AND ads together using PROXY-FRIENDLY networks. Google
# AdSense is banned on proxy sites and is auto-stripped everywhere in the code,
# so it is NEVER used here. Recommended launch stack = 3 networks, ONE per format
# so they never conflict:
#
#     Adsterra    → Popunder          ┐  (page-level scripts)
#     Monetag     → Push / MultiTag   ┘   → go in PROXY_AD_SCRIPTS
#     HilltopAds  → 728×90 footer banner  → goes in PROXY_BANNER_TAG
#
# ── 1. Page-level ad scripts (Adsterra popunder + Monetag push) ───────────────
# Paste each network's loader-script URL, comma-separated. Use only ONE popunder
# network (two popunder tags fight each other). https only; Google URLs refused.
# Example shape (replace with your REAL links):
#   PROXY_AD_SCRIPTS=https://ADSTERRA-POPUNDER-URL/invoke.js,https://MONETAG-PUSH-URL/tag.js
PROXY_AD_SCRIPTS=

# ── 2. Footer display banner (HilltopAds 728×90) ─────────────────────────────
# Paste the raw banner tag (usually two <script> tags) on ONE line. Blank = the
# footer slot never appears (no empty boxes). Google banner code is refused here.
# Example shape:
#   PROXY_BANNER_TAG=<script>atOptions={...}</script><script src=//HILLTOP-BANNER/invoke.js></script>
PROXY_BANNER_TAG=

# ── 3. Optional: ads.txt lines ────────────────────────────────────────────────
# Most popunder networks don't need this. If a network gives you an ads.txt line,
# paste it here (use \n between multiple lines). Served at /ads.txt automatically.
# ADS_TXT_EXTRA=

# ── 4. Extra ad origins for the CSP (usually NOT needed) ─────────────────────
# READ THIS BEFORE DEBUGGING "my ads aren't showing".
#
# The site sends a strict Content-Security-Policy. A script whose origin isn't
# allowlisted is refused BY THE BROWSER - the request never even leaves the
# machine. Tested against the real loader domains Adsterra, HilltopAds and
# Monetag hand out: every one was blocked. The only symptom is a line in the
# browser console, so this looks exactly like "the network isn't paying".
#
# You normally do NOT need to set anything here. The server reads whatever you
# put in PROXY_AD_SCRIPTS / PROXY_BANNER_TAG above and allowlists those origins
# automatically, plus a wildcard for each one's registrable domain (so
# pl123.profitablecpmrate.com also permits *.profitablecpmrate.com, which covers
# most of a network's own chained scripts).
#
# Set this ONLY if a network pulls scripts from a DIFFERENT domain than the one
# you pasted. Symptom: ads still missing, and DevTools → Console shows
# "Refused to load the script 'https://SOMEHOST/...'". Add that host here.
# Comma-separated; wildcards allowed; https only; Google ad domains are refused.
#
#   PROXY_AD_ORIGINS=https://*.someadcdn.com,https://tracker.example.net
#
# Verify at any time with:  npm run check-ads
PROXY_AD_ORIGINS=